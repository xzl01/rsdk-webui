{
  "name": "rsdk-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm -F @rsdk-webui/server dev\" \"pnpm -F @rsdk-webui/web dev\"",
    "build": "pnpm -F @rsdk-webui/web build",
    "start": "pnpm -F @rsdk-webui/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -F @rsdk-webui/shared test && pnpm -F @rsdk-webui/server test",
    "setup": "./ops/setup.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.26.0"
}
